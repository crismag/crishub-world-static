{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleKey": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
    },
    "summary": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "hidden"
      ]
    },
    "author": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "id",
    "status"
  ],
  "additionalProperties": false
}
