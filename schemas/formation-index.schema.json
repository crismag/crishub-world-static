{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "formations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!\\/)(?!.*\\.\\.)[a-z0-9][a-z0-9./_-]*$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "formations"
  ],
  "additionalProperties": false
}
