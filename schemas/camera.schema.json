{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "fovDeg": {
      "type": "number",
      "minimum": 10,
      "maximum": 90
    },
    "near": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "far": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "direction": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "minDistance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxDistance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "defaultDistance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "focusDropDeg": {
      "type": "number",
      "minimum": -45,
      "maximum": 45
    },
    "initialOrientation": {
      "type": "object",
      "properties": {
        "pitchDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "yawDeg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "face": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pitchDeg",
        "yawDeg",
        "face"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "fovDeg",
    "near",
    "far",
    "direction",
    "minDistance",
    "maxDistance",
    "defaultDistance",
    "focusDropDeg",
    "initialOrientation"
  ],
  "additionalProperties": false
}
