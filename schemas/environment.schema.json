{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "lights": {
      "type": "object",
      "properties": {
        "hemisphere": {
          "type": "object",
          "properties": {
            "sky": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "ground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "sky",
            "ground",
            "intensity"
          ],
          "additionalProperties": false
        },
        "ambient": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "color",
            "intensity"
          ],
          "additionalProperties": false
        },
        "key": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "color",
            "intensity",
            "position"
          ],
          "additionalProperties": false
        },
        "fill": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "color",
            "intensity",
            "position"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "hemisphere",
        "ambient",
        "key",
        "fill"
      ],
      "additionalProperties": false
    },
    "stars": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "drift": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "count",
        "radius",
        "depth",
        "size",
        "drift"
      ],
      "additionalProperties": false
    },
    "sun": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "glow": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "position",
        "color",
        "glow",
        "radius"
      ],
      "additionalProperties": false
    },
    "atmosphere": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.5
        }
      },
      "required": [
        "color",
        "strength",
        "scale"
      ],
      "additionalProperties": false
    },
    "clouds": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "puffy": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "altitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "count",
            "color",
            "opacity",
            "altitude",
            "speed"
          ],
          "additionalProperties": false
        },
        "wispy": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "altitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "count",
            "color",
            "opacity",
            "altitude",
            "speed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seed",
        "puffy",
        "wispy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "background",
    "lights",
    "stars",
    "sun",
    "atmosphere",
    "clouds"
  ],
  "additionalProperties": false
}
