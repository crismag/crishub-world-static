{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "labelKey": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          "pluralKey": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          "order": {
            "type": "number"
          },
          "listed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "labelKey",
          "pluralKey",
          "order",
          "listed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "categories"
  ],
  "additionalProperties": false
}
