{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "const": "island-arrangement"
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "draft",
            "hidden"
          ]
        },
        "center": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "uprightAgainstTilt": {
          "type": "boolean"
        },
        "clearanceDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "islands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "atDeg": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "radiusDeg": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 60
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 60
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "headingDeg": {
                "type": "number"
              },
              "ground": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dress": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "forest",
                      "palms",
                      "peak",
                      "pines"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "role",
              "atDeg",
              "radiusDeg",
              "headingDeg",
              "ground",
              "dress"
            ],
            "additionalProperties": false
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "centerDeg": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "radiusDeg": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              },
              "fromDeg": {
                "type": "number"
              },
              "toDeg": {
                "type": "number"
              },
              "lengthsDeg": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 60
                }
              },
              "jitterDeg": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "widthDeg": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              },
              "ground": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dressEvery": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dress": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "forest",
                      "palms",
                      "peak",
                      "pines"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "role",
              "centerDeg",
              "radiusDeg",
              "fromDeg",
              "toDeg",
              "lengthsDeg",
              "jitterDeg",
              "widthDeg",
              "ground",
              "dressEvery",
              "dress"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "type",
        "status",
        "center",
        "uprightAgainstTilt",
        "clearanceDeg",
        "islands",
        "arcs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "const": "islets"
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "draft",
            "hidden"
          ]
        },
        "islands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "radiusDeg": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 60
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 60
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "headingDeg": {
                "type": "number"
              },
              "flatRadiusDeg": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "dress": {
                "type": "string",
                "enum": [
                  "pines",
                  "palms"
                ]
              }
            },
            "required": [
              "id",
              "latitude",
              "longitude",
              "radiusDeg",
              "headingDeg",
              "flatRadiusDeg",
              "dress"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "type",
        "status",
        "islands"
      ],
      "additionalProperties": false
    }
  ]
}
