{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "locationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oval"
            },
            "radiusDeg": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 60
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 60
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "headingDeg": {
              "type": "number"
            },
            "flatRadiusDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            }
          },
          "required": [
            "type",
            "radiusDeg",
            "headingDeg",
            "flatRadiusDeg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "outline"
            },
            "scaleDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "flatRadiusDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            }
          },
          "required": [
            "type",
            "scaleDeg",
            "anchor",
            "parts",
            "flatRadiusDeg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lobes"
            },
            "lobeRadiusDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "bridgeHalfWidthDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "flatRadiusDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "lobes": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "atDeg": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "ground": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "id",
                  "atDeg",
                  "ground"
                ],
                "additionalProperties": false
              }
            },
            "bridges": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "type",
            "lobeRadiusDeg",
            "bridgeHalfWidthDeg",
            "flatRadiusDeg",
            "lobes",
            "bridges"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "locationId",
    "shape"
  ],
  "additionalProperties": false
}
