{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "smileGreeting": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "formation": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "messageKey": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "enabled",
        "formation",
        "messageKey",
        "alignment"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "smileGreeting"
  ],
  "additionalProperties": false
}
